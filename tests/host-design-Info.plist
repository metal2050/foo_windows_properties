<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.metal2050.foo_windows_properties.ui-tests</string>
	<key>CFBundleName</key>
	<string>wpe_ui_tests</string>
	<!-- foobar2000.app's Info.plist has this key, so AppKit runs the classic (pre-macOS 26) design in the
	     host. Embedded in wpe_ui_tests (__TEXT,__info_plist) so the tests lay out and draw the window in
	     the design it meets there; wpe_ui_tests_macos26 runs without it. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
</dict>
</plist>
